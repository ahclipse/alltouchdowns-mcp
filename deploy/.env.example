# Copy to .env on the server and fill in. The real file is never committed: it describes
# the server it runs on.

# Image to run. Pinned by commit, e.g. sha-0123abc...
MCP_IMAGE=ghcr.io/OWNER/alltouchdowns-mcp
MCP_IMAGE_TAG=sha-REPLACE_ME

# The website's data volume, and where inside it the export finds things.
SITE_DATA_VOLUME=
SITE_POINTER_FILE=/site-data/REPLACE_ME
SITE_SNAPSHOT_TEMPLATE=/site-data/REPLACE_ME.{slot}.db
# The website's banned-pattern source file on the host, for the drift check.
SITE_PATTERNS_FILE=

# The Docker network the reverse proxy is on.
PROXY_NETWORK=

# Server settings (see src/alltouchdowns_mcp/config.py).
ATD_ALLOWED_HOSTS=mcp.example.com,mcp.example.com:*
ATD_ALLOWED_ORIGINS=https://mcp.example.com

# This server sits behind a trusted reverse proxy that passes the caller's address along.
ATD_TRUST_PROXY_HEADER=on

# Sign-in (OAuth). Set all three, or none to run without the signed-in endpoint.
ATD_AUTH_ISSUER=
ATD_AUTH_JWKS_URL=
ATD_AUTH_RESOURCE_URL=https://mcp.example.com/auth/mcp

# Rate limits, per minute unless noted. These are the defaults.
# ATD_ANONYMOUS_PER_MINUTE=30
# ATD_SIGNED_IN_PER_MINUTE=300
# ATD_FAILED_SIGN_IN_PER_MINUTE=60
# ATD_TOTAL_PER_SECOND=20
